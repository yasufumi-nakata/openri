FROM python:3.12-slim

WORKDIR /app
COPY pyproject.toml README.md LICENSE MANIFEST.in ./
COPY backend ./backend
RUN python -m pip install --no-cache-dir -U pip && python -m pip install --no-cache-dir ".[pdf,server]"

ENV OPENRI_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
EXPOSE 8008
CMD ["uvicorn", "openri.api:app", "--host", "0.0.0.0", "--port", "8008"]
